<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="RECORD FROM" android:textColor="@color/text_secondary"
        android:textSize="11sp" android:layout_marginBottom="12dp" />

    <!-- Phone Calls -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/card" android:orientation="horizontal"
        android:padding="16dp" android:gravity="center_vertical" android:layout_marginBottom="2dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="📞  Phone Calls"
            android:textColor="@color/text_primary" android:textSize="15sp" />
        <Switch android:id="@+id/switchPhoneCalls" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:checked="true" />
    </LinearLayout>

    <!-- WhatsApp -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/card" android:orientation="horizontal"
        android:padding="16dp" android:gravity="center_vertical" android:layout_marginBottom="2dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="💬  WhatsApp"
            android:textColor="@color/text_primary" android:textSize="15sp" />
        <Switch android:id="@+id/switchWhatsApp" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:checked="true" />
    </LinearLayout>

    <!-- Viber -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/card" android:orientation="horizontal"
        android:padding="16dp" android:gravity="center_vertical" android:layout_marginBottom="2dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="📱  Viber"
            android:textColor="@color/text_primary" android:textSize="15sp" />
        <Switch android:id="@+id/switchViber" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:checked="true" />
    </LinearLayout>

    <!-- Imo -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/card" android:orientation="horizontal"
        android:padding="16dp" android:gravity="center_vertical" android:layout_marginBottom="24dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🎙️  Imo"
            android:textColor="@color/text_primary" android:textSize="15sp" />
        <Switch android:id="@+id/switchImo" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:checked="true" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recordings are saved to:\nMusic/CallRecorder/ on your device storage."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
